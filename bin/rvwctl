#!/usr/bin/python3
"""Send one command to the running listening assistant and print its reply.

Deliberately uses the system python and nothing but the standard library:
this runs on every hotkey press, so start-up time is the whole design.

    rvwctl EXPLAIN
    rvwctl TOGGLE_CAPTURE
    rvwctl STATUS
"""

import os
import socket
import sys

read_size_bytes = 65536
default_socket_path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                                  "var", "run", "rvw.sock")
socket_path = os.environ.get("RVW_CONTROL_SOCKET", default_socket_path)


def read_whole_reply(client):
    """Read until the assistant closes the connection, which it does after replying.

    One read was enough while every reply was a single line. A reply carrying the
    rolling transcript or a whole answer is far larger, and half a transcript in a
    window would look exactly like a transcript.
    """
    received = []
    while True:
        block = client.recv(read_size_bytes)
        if not block:
            return b"".join(received).decode("utf-8", "replace").strip()
        received.append(block)


def send_command(command_line):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(30.0)
    client.connect(socket_path)
    with client:
        client.sendall(command_line.encode("utf-8"))
        return read_whole_reply(client)


def main(arguments):
    if not arguments:
        print("FAIL usage: rvwctl COMMAND [arguments]", file=sys.stderr)
        return 2
    try:
        reply = send_command(" ".join(arguments))
    except OSError as error:
        print("FAIL the assistant is not listening on %s (%s)" % (socket_path, error),
              file=sys.stderr)
        return 1
    print(reply)
    return 0 if reply.startswith("OK ") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
